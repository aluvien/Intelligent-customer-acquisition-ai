# 复制为 .env 并填写真实值。不要把 .env 提交到 Git。
NODE_ENV=production

# PostgreSQL
DB_NAME=xinglian_yunke
DB_USER=xinglian_yunke
# 建议使用 openssl rand -hex 32，确保密码可安全放入 DATABASE_URL
DB_PASSWORD=replace-with-a-long-hex-password
DATABASE_URL=postgresql://xinglian_yunke:replace-with-a-long-hex-password@localhost:5432/xinglian_yunke
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Redis
REDIS_URL=redis://redis:6379

# 认证与加密：使用命令生成，不要使用示例值
# openssl rand -base64 48       -> JWT_SECRET
# openssl rand -base64 32       -> ENCRYPTION_KEY（必须解码后 32 字节）
JWT_SECRET=replace-with-at-least-32-random-characters
ENCRYPTION_KEY=replace-with-base64-32-byte-key
JWT_ISSUER=xinglian-yunke
JWT_AUDIENCE=xinglian-yunke-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Web
CORS_ORIGIN=https://your-admin-domain.example
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
ALLOW_SELF_REGISTRATION=false
FRONTEND_PORT=3000

# AI（没有配置时 AI 草稿会明确标记 blocked，不返回兜底话术）
AI_PROVIDER=coze
COZE_API_URL=
COZE_BOT_ID=
COZE_TOKEN=

# 抖音网站应用 OAuth：回调地址必须是已登记的 HTTPS URL
# 账号授权仅证明 OAuth 身份；评论、私信、直播和回复还需要各自获批的 scope 与真实验收
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
DOUYIN_REDIRECT_URI=https://your-admin-domain.example/api/channels/douyin/oauth/callback
DOUYIN_SCOPES=user_info

# 限流/请求体
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PUBLIC_RATE_LIMIT_MAX_REQUESTS=400
AI_MAX_RUNS_PER_CONVERSATION_HOUR=20
# 生产入口通常经过一层 Nginx；开发 Compose 会在 docker-compose.dev.yml 中覆盖为 0
TRUST_PROXY_HOPS=1
MAX_BODY_BYTES=10
